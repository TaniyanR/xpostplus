APP_ENV=production
APP_KEY=replace-with-at-least-32-random-characters
XPOSTPLUS_ALLOW_INSTALL=0

# MariaDB（MySQL）を使用する場合は mysql を指定します。
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xpostplus
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# SQLiteを使用する場合
# DB_DRIVER=sqlite
# SQLITE_PATH=/absolute/path/to/storage/database.sqlite
